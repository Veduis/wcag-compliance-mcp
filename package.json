{
  "name": "wcag-compliance-mcp",
  "version": "1.0.0",
  "description": "MCP server for WCAG 2.2 audits, verified remediation examples, and U.S. ADA Title II / Section 504 compliance deadlines. Backed by 64 browser-verified fail/pass pairs tested against axe-core 4.14.0.",
  "type": "module",
  "main": "src/index.mjs",
  "bin": {
    "wcag-compliance-mcp": "src/index.mjs"
  },
