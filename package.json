    "src",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wcag",
    "wcag-2.2",
    "accessibility",
    "a11y",
    "ada",
    "section-508",
    "section-504",
    "axe-core",
    "compliance",
    "audit"
  ],
  "author": "Veduis LLC (https://veduis.com/)",
  "license": "MIT",
  "homepage": "https://veduis.com/products/vcompliance-scanner/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veduis/wcag-compliance-mcp.git"
  },
  "bugs": {
    "url": "https://veduis.com/contact/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "node-html-parser": "^9.0.5",
    "zod": "^4.6.7"
  }
}
